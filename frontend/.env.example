# Endereço base do servidor HTTP do ESP32
# Exemplo com Wokwi para VS Code (port forwarding no wokwi.toml): http://localhost:8180
# Exemplo com Wokwi Private IoT Gateway (wokwigw): http://localhost:9080
# Exemplo com ESP32 físico na rede local: http://192.168.1.100
VITE_ESP32_BASE_URL=http://localhost:8180
